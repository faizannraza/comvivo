{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["./tsconfig.base.json", "./tsconfig.paths.json"],
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": false,
    "types": ["node"]
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "packages/**/*.tsx", "apps/**/*.tsx"]
}
