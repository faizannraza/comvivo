{
  "name": "@comvivo/plugin-sdk",
  "version": "0.0.0",
  "type": "module",
  "description": "The public, semver-stable API third parties build against: tool, channel and skill definitions.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faizannraza/comvivo.git",
    "directory": "packages/plugin-sdk"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('.turbo',{recursive:true,force:true})\"",
    "api:check": "pnpm -w exec api-extractor run --config packages/plugin-sdk/api-extractor.json",
    "api:update": "pnpm -w exec api-extractor run --local --config packages/plugin-sdk/api-extractor.json",
    "test": "pnpm -w exec vitest run packages/plugin-sdk"
  },
  "dependencies": {
    "@comvivo/core": "workspace:*",
    "@comvivo/shared": "workspace:*",
    "@comvivo/channel-sdk": "workspace:*"
  },
  "peerDependencies": {
    "temporal-polyfill": "^1.0.6",
    "zod": "^4.6"
  },
  "devDependencies": {
    "temporal-polyfill": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
