{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/shared"
    },
    {
      "path": "../../packages/engine"
    },
    {
      "path": "../../packages/models"
    },
    {
      "path": "../../packages/storage"
    },
    {
      "path": "../../packages/channels/sdk"
    },
    {
      "path": "../../packages/channels/simulator"
    },
    {
      "path": "../../packages/tools"
    }
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.int.test.ts",
    "src/**/*.contract.test.ts",
    "src/**/*.prop.test.ts",
    "src/**/*.bench.ts",
    "src/**/__fixtures__/**",
    "src/**/*.scenario.ts"
  ]
}
