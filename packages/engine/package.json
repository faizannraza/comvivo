{
  "name": "@comvivo/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Application services: ingestion, per-group actors, the router, the turn orchestrator, the IFC-filtered context builder, the declassifier, the disclosure guard, memory services, the proactivity engine, the scheduler, digests and the consent flows.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faizannraza/comvivo.git",
    "directory": "packages/engine"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('.turbo',{recursive:true,force:true})\"",
    "test": "pnpm -w exec vitest run packages/engine"
  },
  "dependencies": {
    "@comvivo/core": "workspace:*",
    "@comvivo/shared": "workspace:*",
    "@comvivo/channel-sdk": "workspace:*",
    "@comvivo/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@comvivo/models": "workspace:*",
    "fast-check": "catalog:",
    "vitest": "catalog:"
  }
}
