{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner", "@stryker-mutator/typescript-checker"],
  "checkers": ["typescript"],
  "tsconfigFile": "packages/core/tsconfig.json",
  "vitest": {
    "configFile": "packages/core/vitest.mutation.config.ts",
    "related": true,
    "pool": "forks"
  },
  "mutate": [
    "packages/core/src/**/*.ts",
    "!packages/core/src/ifc/**",
    "!packages/core/src/policy/**",
    "!packages/core/src/**/*.test.ts",
    "!packages/core/src/testing/**",
    "!packages/core/src/index.ts"
  ],
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental-core.json",
  "thresholds": {
    "high": 85,
    "low": 75,
    "break": 60
  },
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/core.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/core.json"
  },
  "timeoutMS": 20000,
  "tempDirName": ".stryker-tmp/core"
}
