{
  "name": "@comvivo/mcp-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A tiny standalone bridge a member installs in their own agent (Claude Desktop, Cursor) to reach their group with their own authority.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faizannraza/comvivo.git",
    "directory": "packages/mcp-bridge"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('.turbo',{recursive:true,force:true})\"",
    "test": "pnpm -w exec vitest run packages/mcp-bridge"
  },
  "dependencies": {
    "@comvivo/shared": "workspace:*"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
