{
  "name": "@comvivo/tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Built-in tools: calendar, reminders, tasks and chores, lists, polls, plans, decisions, memory, catch-up, settings and the constitution.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faizannraza/comvivo.git",
    "directory": "packages/tools"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('.turbo',{recursive:true,force:true})\"",
    "test": "pnpm -w exec vitest run packages/tools"
  },
  "dependencies": {
    "@comvivo/core": "workspace:*",
    "@comvivo/shared": "workspace:*",
    "@comvivo/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
