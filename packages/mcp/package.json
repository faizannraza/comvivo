{
  "name": "@comvivo/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The member-scoped MCP server served at /mcp on the main listener, plus the MCP client for gated external tools.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faizannraza/comvivo.git",
    "directory": "packages/mcp"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('.turbo',{recursive:true,force:true})\"",
    "test": "pnpm -w exec vitest run packages/mcp"
  },
  "dependencies": {
    "@comvivo/core": "workspace:*",
    "@comvivo/shared": "workspace:*",
    "@comvivo/engine": "workspace:*"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
