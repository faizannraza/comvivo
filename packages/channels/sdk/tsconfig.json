{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    // `M3-T2`: the same decision `packages/plugin-sdk/tsconfig.json` records, for the same
    // reason. `06` §4.1's contract names `AbortSignal` (`AdapterContext.signal`),
    // `ReadableStream` (`fetchAttachment`, `OutboundAttachment.open`), `Request`/`Response`
    // (`WebhookRegistrar`) and `typeof globalThis.fetch` — platform types in neither `lib.es2024`
    // nor an empty `types` array. Node's types are the narrowest way to get them; the DOM lib
    // would bring `window` and `document` into a package third parties compile against.
    //
    // This does **not** relax the purity rule, which is lint-enforced: `comvivo/channel-sdk-purity`
    // in `eslint.config.ts` bans `Date`, `process`, `fetch`, `Math.random` and the timers over
    // `packages/channels/sdk/**` — every one has a replacement on the `AdapterContext` an adapter
    // is handed, and this is the package whose examples adapter authors copy. dependency-cruiser
    // still refuses a `node:*` **import** here (`PURE_PACKAGES`), which is the other half.
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../../packages/core"
    },
    {
      "path": "../../../packages/shared"
    }
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.int.test.ts",
    "src/**/*.contract.test.ts",
    "src/**/*.prop.test.ts",
    "src/**/*.bench.ts",
    "src/**/__fixtures__/**",
    "src/**/*.scenario.ts"
  ]
}
