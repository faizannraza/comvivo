{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    // `M3-T11`: the same decision `packages/channels/sdk/tsconfig.json` records, for the same
    // reason and nothing more. `06` §4.1 names `ReadableStream` (`fetchAttachment`) and
    // `AbortSignal` (`AdapterContext.signal`), which are in neither `lib.es2024` nor an empty
    // `types` array; Node types are the narrowest way to have them, and the DOM lib would pull
    // `window` into a package the browser demo and a Node harness both compile against. It does
    // not relax purity: a `node:*` **import** here is still refused by dependency-cruiser
    // (`PURE_PACKAGES`) and by the lint rule over `packages/channels/simulator/**`.
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../../packages/channels/sdk"
    },
    {
      "path": "../../../packages/core"
    },
    {
      "path": "../../../packages/shared"
    }
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.int.test.ts",
    "src/**/*.contract.test.ts",
    "src/**/*.prop.test.ts",
    "src/**/*.bench.ts",
    "src/**/__fixtures__/**",
    "src/**/*.scenario.ts"
  ]
}
