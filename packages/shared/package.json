{
  "name": "@comvivo/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cross-cutting primitives: branded ids, typed errors, Result helpers, zod utilities, the redacting logger, the config loader, the BRAND constant, and the Clock/IdGenerator/Rng ports.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faizannraza/comvivo.git",
    "directory": "packages/shared"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('.turbo',{recursive:true,force:true})\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "fast-check": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "pino": "catalog:",
    "pure-rand": "catalog:",
    "temporal-polyfill": "catalog:",
    "typeid-js": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  }
}
