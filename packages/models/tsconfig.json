{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": ["node"]
  },
  // `*.json` too, because `05` §3.5.2's capability registry and presets are **data**: zod-validated
  // at load (`registry/capabilities.ts`) and imported with `with { type: 'json' }` so a typo in
  // either file is a build error rather than a runtime surprise. `resolveJsonModule` is on in the
  // base config, and `tsc` copies an included JSON file into `outDir`, so `dist` ships them.
  "include": ["src/**/*.ts", "src/**/*.json"],
  "references": [
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/shared"
    }
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.int.test.ts",
    "src/**/*.contract.test.ts",
    "src/**/*.prop.test.ts",
    "src/**/*.bench.ts",
    "src/**/__fixtures__/**",
    "src/**/*.scenario.ts"
  ]
}
