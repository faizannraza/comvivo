{
  "name": "@comvivo/models",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ModelGateway adapters (Anthropic, OpenAI, Google, OpenAI-compatible local servers), embedding and transcription providers, usage and cost accounting, and the deterministic fake gateways.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faizannraza/comvivo.git",
    "directory": "packages/models"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('.turbo',{recursive:true,force:true})\"",
    "test": "pnpm -w exec vitest run packages/models"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@comvivo/core": "workspace:*",
    "@comvivo/shared": "workspace:*",
    "openai": "catalog:"
  },
  "devDependencies": {
    "fast-check": "catalog:",
    "vitest": "catalog:"
  }
}
