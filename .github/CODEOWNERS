/packages/storage/src/crypto/           @faizannraza
/packages/shared/src/crypto/            @faizannraza
/packages/shared/src/net/               @faizannraza
# The logger is here because `01` §11.7 — no message or memory content above debug — is enforced
# by this code and nothing else.
/packages/shared/src/logger/            @faizannraza
/packages/shared/src/secrets/           @faizannraza
/packages/shared/src/observability/     @faizannraza

