# code gets installed and what is allowed to run an install script.
/.github/                               @faizannraza
/pnpm-lock.yaml                         @faizannraza
/pnpm-workspace.yaml                    @faizannraza
/deploy/names.json                      @faizannraza
/scripts/supply/                        @faizannraza
