{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/*.mdx",
      "!**/*.md",
      "!**/dist",
      "!**/node_modules",
      "!**/.turbo",
      "!**/.vitest",
      "!**/reports",
      "!**/coverage",
      "!**/__snapshots__",
      "!**/*.telegram.html",
      "!**/*.discord.md",
      "!**/*.slack.mrkdwn",
      "!**/*.matrix.html",
      "!pnpm-lock.yaml",
      "!docs/plan",
      "!docs/research",
      "!apps/docs/src/content",
      "!packages/api-client/src/generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // OFF, deliberately. It wants `process.env.FOO` where TypeScript's
        // `noPropertyAccessFromIndexSignature` (tsconfig.base.json) *requires* `process.env['FOO']`,
        // because `process.env` is an index signature. The two rules contradict each other, and the
        // TypeScript one is the valuable half: it makes a typo in an env var name a compile error.
        // Threshold raised from the default 15. Configuration parsing is branchy by nature — a
        // loader that reads a file, an env file, the real environment and the database, each with its
        // own failure mode, sits around 16-17 with every branch earning its place. Splitting further
        // would trade readable code for artificial indirection. 20 keeps the rule biting on genuinely
        // tangled functions.
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": { "maxAllowedComplexity": 20 }
        },
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUndeclaredDependencies": "error"
      },
      "style": {
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "noNonNullAssertion": "error",
        "useImportType": "error",
        "useExportType": "error",
        "noParameterAssign": "error",
        "useThrowOnlyError": "error"
      },
      "suspicious": {
        // OFF, deliberately. Biome reads declared variables from `.env` files, which are gitignored
        // here (they hold secrets), so the rule cannot work in CI and only fires locally for people
        // who happen to have a `.env`. The authoritative declaration of every variable is the zod
        // config schema in `@comvivo/shared/config` (`01` §11.2, ADR-014), and `M3-T54` generates the
        // env reference from it — a stronger guard than this rule, and one that cannot drift.
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn"]
          }
        },
        "noDoubleEquals": "error",
        "noUndeclaredEnvVars": "off"
      },
      "performance": {
        "noDelete": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/core/**",
        "packages/tools/**",
        "packages/channels/sdk/**",
        "packages/channels/simulator/**",
        "packages/plugin-sdk/**",
        "packages/api-client/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.int.test.ts",
        "**/*.contract.test.ts",
        "**/*.prop.test.ts",
        "**/testing/**",
        "**/*.bench.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noConsole": "off",
            // A test that plants a literal `${...}` is usually asserting that the parser does NOT
            // interpolate it, so the placeholder has to stay literal for the test to mean anything.
            "noTemplateCurlyInString": "off"
          },
          "style": {
            // A test knows its own fixture is present. `leafFor('dashboard.port')!` reads better
            // than threading an optional through every assertion, and a wrong assumption fails
            // loudly on the next line anyway.
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**", "tools/**"],
      "linter": {
        "rules": {
          "suspicious": {
            // OFF, deliberately. Biome reads declared variables from `.env` files, which are gitignored
            // here (they hold secrets), so the rule cannot work in CI and only fires locally for people
            // who happen to have a `.env`. The authoritative declaration of every variable is the zod
            // config schema in `@comvivo/shared/config` (`01` §11.2, ADR-014), and `M3-T54` generates the
            // env reference from it — a stronger guard than this rule, and one that cannot drift.
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["test/fixtures/**", "test/boundaries/**"],
      "linter": {
        "rules": {
          "suspicious": {
            // OFF, deliberately. Biome reads declared variables from `.env` files, which are gitignored
            // here (they hold secrets), so the rule cannot work in CI and only fires locally for people
            // who happen to have a `.env`. The authoritative declaration of every variable is the zod
            // config schema in `@comvivo/shared/config` (`01` §11.2, ADR-014), and `M3-T54` generates the
            // env reference from it — a stronger guard than this rule, and one that cannot drift.
            "noConsole": "off",
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
