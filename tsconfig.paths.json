{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Comvivo workspace paths",
  // Every workspace package name mapped to its **source** entry point.
  //
  // One file, read by three things that would otherwise disagree:
  //
  //   - `tsconfig.depcruise.json`, so dependency-cruiser sees `src/` rather than resolving a
  //     workspace import through `node_modules` into `dist/` — where a rule anchored on a `src/`
  //     path matches nothing and reports success. That is the defect that opened M0.
  //   - `tsconfig.test.json`, so `tsc` can type a test that imports a sibling package without a
  //     build having run first.
  //   - `vitest.shared.ts`, which builds its `resolve.alias` from this file, so a test runs
  //     against source and never against a stale or missing `dist/`.
  //
  // The three drifting apart is exactly the kind of silent gap this repository keeps finding, so
  // `test/boundaries/depcruise-paths.test.ts` asserts that every declared package export has an
  // entry here, that every entry points at a file that exists, and that the Vitest alias covers
  // the same set.
  // No `baseUrl`: it is deprecated in TypeScript 6 and removed in 7 (`TS5101`), and since
  // TypeScript 5 a `paths` entry without one resolves relative to the config file that declares
  // it — which is this file, at the repository root. So the targets below are repo-relative and
  // stay correct for every config that extends this one.
  "compilerOptions": {
    "paths": {
      // Repeated from `tsconfig.base.json`, not inherited: an `extends` array merges
      // `compilerOptions` key by key, so the `paths` declared here **replaces** the base's rather
      // than adding to it. Leaving it out silently dropped the driver's type mapping and every
      // import of it became `TS7016`. `test/boundaries/depcruise-paths.test.ts` asserts the two
      // copies agree, because a duplicated mapping that drifts is worse than one that is absent.
      "better-sqlite3-multiple-ciphers": [
        "./packages/storage/node_modules/better-sqlite3-multiple-ciphers/index.d.ts"
      ],
      "@comvivo/api-client": ["./packages/api-client/src/index.ts"],
      "@comvivo/channel-discord": ["./packages/channels/discord/src/index.ts"],
      "@comvivo/channel-matrix": ["./packages/channels/matrix/src/index.ts"],
      "@comvivo/channel-sdk": ["./packages/channels/sdk/src/index.ts"],
      "@comvivo/channel-sdk/testing": ["./packages/channels/sdk/src/testing/index.ts"],
      "@comvivo/channel-signal": ["./packages/channels/signal/src/index.ts"],
      "@comvivo/channel-simulator": ["./packages/channels/simulator/src/index.ts"],
      "@comvivo/channel-slack": ["./packages/channels/slack/src/index.ts"],
      "@comvivo/channel-telegram": ["./packages/channels/telegram/src/index.ts"],
      "@comvivo/channel-web": ["./packages/channels/web/src/index.ts"],
      "@comvivo/core": ["./packages/core/src/index.ts"],
      "@comvivo/core/testing": ["./packages/core/src/testing/index.ts"],
      "@comvivo/dashboard": ["./apps/dashboard/src/index.ts"],
      "@comvivo/engine": ["./packages/engine/src/index.ts"],
      "@comvivo/engine/testing": ["./packages/engine/src/testing/index.ts"],
      "@comvivo/evals": ["./packages/evals/src/index.ts"],
      "@comvivo/evals/arbitraries": ["./packages/evals/src/arbitraries/index.ts"],
      "@comvivo/mcp": ["./packages/mcp/src/index.ts"],
      "@comvivo/mcp-bridge": ["./packages/mcp-bridge/src/index.ts"],
      "@comvivo/models": ["./packages/models/src/index.ts"],
      "@comvivo/models/testing": ["./packages/models/src/testing/index.ts"],
      "@comvivo/plugin-host": ["./packages/plugin-host/src/index.ts"],
      "@comvivo/plugin-sdk": ["./packages/plugin-sdk/src/index.ts"],
      "@comvivo/server": ["./apps/server/src/index.ts"],
      "@comvivo/shared": ["./packages/shared/src/index.ts"],
      "@comvivo/shared/crypto": ["./packages/shared/src/crypto/index.ts"],
      "@comvivo/shared/observability": ["./packages/shared/src/observability/index.ts"],
      "@comvivo/shared/testing": ["./packages/shared/src/testing/index.ts"],
      "@comvivo/storage": ["./packages/storage/src/index.ts"],
      "@comvivo/storage/crypto": ["./packages/storage/src/crypto/index.ts"],
      "@comvivo/storage/testing": ["./packages/storage/src/testing/index.ts"],
      "@comvivo/tools": ["./packages/tools/src/index.ts"],
      "comvivo": ["./apps/cli/src/index.ts"]
    }
  }
}
