{
  "name": "@comvivo/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The React single-page dashboard, served as static assets by the server.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faizannraza/comvivo.git",
    "directory": "apps/dashboard"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('.turbo',{recursive:true,force:true})\"",
    "test": "pnpm -w exec vitest run apps/dashboard"
  },
  "dependencies": {
    "@comvivo/api-client": "workspace:*"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
