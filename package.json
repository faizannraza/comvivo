{
  "name": "comvivo-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Comvivo — the open-source AI that belongs to your group, not to one person.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faizannraza/comvivo.git"
  },
  "homepage": "https://github.com/faizannraza/comvivo",
  "bugs": {
    "url": "https://github.com/faizannraza/comvivo/issues"
  },
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "error"
    }
  },
  "scripts": {
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run depcruise && pnpm run brand:check && pnpm run names:check && pnpm run supply:check && pnpm run secrets:check && pnpm run hygiene:check && pnpm run renovate:check && pnpm run prose && pnpm run plan:test && pnpm run plan:check && pnpm run schema:check && pnpm run test && pnpm run coverage && pnpm run build && pnpm run docs:build && pnpm run evals:smoke",
    "lint": "biome ci . --colors=off && eslint . --max-warnings 0",
    "lint:fix": "biome check --write . && eslint . --fix",
    "format": "biome format --write .",
    "typecheck": "tsc -b --pretty && tsc -p tsconfig.scripts.json --pretty && tsc -p tsconfig.test.json --pretty",
    "typecheck:watch": "tsc -b --watch --pretty",
    "depcruise": "depcruise packages apps --config",
    "depcruise:graph": "depcruise packages apps --config --output-type dot | dot -T svg > reports/dependency-graph.svg",
    "brand:check": "tsx scripts/brand/check.ts",
    "plan:test": "python3 scripts/plan/trace.test.py",
    "plan:check": "python3 scripts/plan/trace.py --check",
    "build": "turbo run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:contract": "vitest run --project contract",
    "test:scenario": "vitest run --project scenario",
    "test:guards": "vitest run --project unit --project integration test/boundaries test/docs-ia scripts/ packages/shared/src/logger/scrub.test.ts",
    "schema:doc": "tsx scripts/schema-doc.ts",
    "schema:check": "tsx scripts/schema-doc.ts --check",
    "mutation": "stryker run packages/core/stryker.config.json",
    "mutation:ifc": "stryker run packages/core/stryker.ifc-policy.config.json",
    "test:prop": "FC_NUM_RUNS=${FC_NUM_RUNS:-500} vitest run .prop.",
    "bench": "tsx --tsconfig tsconfig.runtime.json scripts/bench/run.ts",
    "coverage": "vitest run --coverage",
    "evals:smoke": "turbo run evals:smoke",
    "evals:live": "node scripts/pending.mjs \"pnpm evals:live\" M2-T19 \"run the eval suites against real models, inside the approved budget\" \"pnpm evals:smoke, which uses the deterministic fake gateways\"",
    "dev": "node scripts/pending.mjs \"pnpm dev\" M3-T42 \"run the server and dashboard in watch mode on the simulator channel\" \"pnpm test:watch\"",
    "db:generate": "pnpm --filter @comvivo/storage db:generate",
    "db:migrate": "pnpm --filter @comvivo/storage db:migrate",
    "clean": "turbo run clean && node -e \"for (const p of ['node_modules/.cache','.turbo','reports','.vitest','coverage']) fs.rmSync(p,{recursive:true,force:true})\"",
    "supply:check": "tsx scripts/supply/check-native.ts && pnpm run supply:lockfile",
    "test:dashboard": "vitest run --project dashboard",
    "secrets:check": "tsx scripts/security/check-literal-secrets.ts",
    "hygiene:check": "tsx scripts/hygiene/check.ts",
    "supply:lockfile": "tsx scripts/supply/check-lockfile.ts",
    "renovate:check": "bash scripts/ci/validate-renovate.sh",
    "changeset": "changeset",
    "changeset:required": "tsx scripts/release/changeset-required.ts",
    "names:check": "tsx scripts/names/check.ts",
    "names:apply": "tsx scripts/names/apply.ts",
    "labels:sync": "tsx scripts/github/sync-labels.ts",
    "docs:build": "pnpm --filter @comvivo/docs build",
    "docs:dev": "pnpm --filter @comvivo/docs dev",
    "prose": "bash scripts/ci/check-prose.sh",
    "brand:rename": "tsx scripts/brand/rename.ts",
    "gate": "pnpm run verify && pnpm run hygiene:check -- --gate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6",
    "@changesets/cli": "^3.0.3",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^24.9",
    "@vitest/coverage-v8": "^5.0",
    "dependency-cruiser": "^18.7",
    "drizzle-orm": "catalog:",
    "eslint": "^10.13",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.21",
    "turbo": "^2.11",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72",
    "vite": "^8.3",
    "vitest": "^5.0",
    "yaml": "^2.9.1",
    "zod": "catalog:"
  }
}
